#!/usr/bin/env bash
# Wrapper for Rust persistence binary (list sessions)
# Usage: uncensored-history

set -euo pipefail

BINARY="$(dirname "$0")/../.uncensored/rust_persistence/target/release/uncensored-persistence"

if [ ! -x "$BINARY" ]; then
  echo "Error: Rust persistence binary not found or not executable at $BINARY"
  echo "Build it first: cd .uncensored/rust_persistence && cargo build --release"
  exit 1
fi

"$BINARY" list

# Simple history viewer for uncensored agent
COMMAND=${1:-"--tail"}
ARG=${2:-"10"}

case $COMMAND in
    --tail)
        tail -n $ARG .uncensored/history.jsonl
        ;;
    --stats)
        echo "Operation Statistics:"
        jq -r '.action' .uncensored/history.jsonl | sort | uniq -c | sort -nr
        ;;
    *)
        # Search for keyword
        grep "$COMMAND" .uncensored/history.jsonl
        ;;
esac