#!/usr/bin/env bash
# Wrapper for Rust persistence binary
# Usage: uncensored-save <session_name>

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: $0 <session_name>"
  exit 1
fi

SESSION_NAME="$1"

# Resolve binary path (assumes binary built in ./target/release)
BINARY="$(dirname "$0")/../.uncensored/rust_persistence/target/release/uncensored-persistence"

if [ ! -x "$BINARY" ]; then
  echo "Error: Rust persistence binary not found or not executable at $BINARY"
  echo "Build it first: cd .uncensored/rust_persistence && cargo build --release"
  exit 1
fi

"$BINARY" save "$SESSION_NAME"