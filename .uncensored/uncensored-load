#!/usr/bin/env bash
# Wrapper for Rust persistence binary (load)
# Usage: uncensored-load <session_name>

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: $0 <session_name>"
  exit 1
fi

SESSION_NAME="$1"
BINARY="$(dirname "$0")/../.uncensored/rust_persistence/target/release/uncensored-persistence"

if [ ! -x "$BINARY" ]; then
  echo "Error: Rust persistence binary not found or not executable at $BINARY"
  echo "Build it first: cd .uncensored/rust_persistence && cargo build --release"
  exit 1
fi

"$BINARY" load "$SESSION_NAME"

# Copy named snapshot to current state
cp ".uncensored/sessions/${NAME}.json" .uncensored/state.json

# Log the load operation
echo '{"ts": "'$(date -Iseconds)'", "action": "Loaded state from '"${NAME}"'", "files": [".uncensored/state.json"], "tokens_used": 0, "status": "completed"}' >> .uncensored/history.jsonl

echo "State loaded from .uncensored/sessions/${NAME}.json"